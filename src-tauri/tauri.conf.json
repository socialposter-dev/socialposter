{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SocialPoster",
  "version": "0.3.0",
  "identifier": "com.afuxy.socialposter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SocialPoster",
        "width": 800,
        "height": 600,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMTZENEY1MTQ3MjQxMzUKUldRMVFYSVU5ZFFXNDJ4Y3NxSUJNQjA2QURsVmlnMnVGZDJ0a1pSbS9tQ0dBUlRST1JsSG5nTUMK",
      "endpoints": [
        "https://github.com/socialposter-dev/socialposter/releases/latest/download/latest.json"
      ]
    }
  }
}